# Copy to .env.local for local overrides. Never commit real URLs with secrets
# (this file itself holds no secrets and is safe to commit).
#
# Local dev: leave EMPTY (same-origin /api via the Vite dev proxy).
VITE_API_BASE_URL=
#
# Production on Vercel: set to the Render backend origin with NO trailing
# slash and NO /api suffix, then REDEPLOY (Vite embeds it at build time).
# Shape only — use your real service hostname from the Render dashboard:
# VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
