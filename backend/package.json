    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "supertest": "^6.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "body-parser": "1.20.9"
