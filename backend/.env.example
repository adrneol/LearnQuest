# LearnQuest backend configuration
# Copy to .env and fill in the blank values. Never commit .env.
# Generate secrets locally (never reuse the examples):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- Runtime / HTTP ---
NODE_ENV=development
# Render supplies PORT. Do not copy the local port into a production service.
PORT=3001
# Render-only runtime pin. This is not read by the application and must not be
# added to Vercel. Keep local development on a supported Node 24 LTS patch.
# NODE_VERSION=24.22.1
# Production cookies are SameSite=Lax. The public frontend and API must be
# same-site (same-origin /api proxy or app./api. custom subdomains), not
# *.vercel.app calling *.onrender.com directly.
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
# Exact comma-separated browser origins. Wildcards are rejected.
CORS_ORIGIN=http://localhost:5173
# Reverse-proxy hops in front of Express. Local direct = 0; Render alone = 1;
# Vercel /api rewrite -> Render = 2. Never trust more hops than the real chain.
TRUST_PROXY_HOPS=1

# --- Request limits / cache ---
CACHE_TTL_SEC=600
CACHE_MAX_ENTRIES=50
RATE_LIMIT_PER_MIN=30
AUTH_RATE_LIMIT_PER_MIN=20
EMAIL_ACTION_RATE_LIMIT_PER_15MIN=8
ACCOUNT_MAX_STATE_BYTES=8388608

# --- YouTube Data API v3 ---
# Secret. Required only for live playlist URL imports; JSON import works offline.
YOUTUBE_API_KEY=

# --- MongoDB (required for accounts and cloud sync) ---
MONGODB_URI=
MONGODB_DB_NAME=learnquest

# --- Learning-data storage backend (advanced; default is the legacy layout) ---
# `legacy` reads/writes the per-domain lq_data_* collections. `unified` reads
# and writes the consolidated lq_user_data collection after a verified
# migration. There is no automatic fallback between them.
LQ_USER_DATA_STORE=legacy
# Required in production only when LQ_USER_DATA_STORE=unified. Set it after a
# backed-up, owner-approved migration has been independently verified.
# The literal value is: lq-data-to-user-data-v1
# LQ_USER_DATA_CUTOVER_ACK=

# --- Google OAuth / OIDC (required; Google is the only registration path) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the public callback the browser actually reaches (proxy or API domain).
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# --- Brevo transactional email (required for recovery and email verification) ---
# The sender address/domain must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LearnQuest

# --- Session and email-action secrets (required; generate unique values) ---
SESSION_SECRET=
# Dedicated HMAC key for single-use email action links. If an existing
# deployment already has OTP_HMAC_SECRET, the server accepts it as a legacy
# fallback so pending configuration can be migrated without breaking auth.
EMAIL_ACTION_HMAC_SECRET=
# Generate a separate value for every environment. Never reuse SESSION_SECRET
# or a production value in local development.
# Legacy aliases (optional; used only when the dedicated name is empty):
# OTP_HMAC_SECRET=
# OTP_TTL_MIN=
# OTP_RESEND_SEC=
# OTP_RATE_LIMIT_PER_15MIN=

# --- Session / email-action policy ---
SESSION_IDLE_HOURS=168
SESSION_ABSOLUTE_DAYS=30
REAUTH_WINDOW_MIN=10
EMAIL_ACTION_TTL_MIN=30
EMAIL_ACTION_RESEND_SEC=60
